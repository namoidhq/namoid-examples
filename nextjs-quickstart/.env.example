# --- NamoID OAuth client (create one at https://namoid.in/dashboard/projects/<id>/settings) ---
NAMOID_ISSUER=https://api.namoid.in
NAMOID_CLIENT_ID=namoid_client_xxxxxxxxxxxxxxxx
NAMOID_CLIENT_SECRET=cs_live_xxxxxxxxxxxxxxxxxxxx

# --- Auth.js session encryption (any 32-byte secret; generate with `openssl rand -base64 32`) ---
AUTH_SECRET=replace-me

# --- Where Auth.js builds redirect URIs from ---
# When you register the client at NamoID, add this as an allowed redirect_uri:
#   http://localhost:3001/api/auth/callback/namoid
AUTH_URL=http://localhost:3001
