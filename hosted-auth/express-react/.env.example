# Application credentials from the selected NamoID environment.
NAMOID_CLIENT_ID=namoid_client_test_xxxxxxxxxxxxxxxx
NAMOID_CLIENT_SECRET=namoid_secret_test_xxxxxxxxxxxxxxxx

# Public origin registered in the NamoID application's redirect URIs.
# Use http://localhost:5174 while running pnpm dev.
APP_BASE_URL=http://localhost:5174

# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters

# Express listens here; Vite proxies /api to this port during development.
PORT=4000
