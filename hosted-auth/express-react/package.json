{
  "name": "@namoid-examples/hosted-auth-express-react",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,blue \"tsx watch server/index.ts\" \"vite --config client/vite.config.ts\"",
    "build": "vite build --config client/vite.config.ts && tsc -p server/tsconfig.json",
    "start": "node server/dist/index.js",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@namoidhq/js": "^2.0.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.0",
    "helmet": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
