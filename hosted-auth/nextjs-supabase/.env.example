# Copy these application credentials from the NamoID Console.
NAMOID_CLIENT_ID=namoid_client_test_xxxxxxxxxxxxxxxx
# Server-only. Never expose this as NEXT_PUBLIC_*.
NAMOID_CLIENT_SECRET=namoid_secret_test_xxxxxxxxxxxxxxxx

# Public URL of this application. Register its callback URL in NamoID:
# http://localhost:3002/api/auth/callback
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Supabase Project Settings > Data API.
SUPABASE_URL=https://your-project.supabase.co

# Server-only Supabase secret key. Never expose this as NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
