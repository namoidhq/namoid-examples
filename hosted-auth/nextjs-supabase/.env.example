# Server-only. Create this key for the application in the NamoID Console.
NAMOID_AUTH_SECRET_KEY=namoid_auth_sk_test_xxxxxxxxxxxxxxxx

# Public URL of this application. Register its callback URL in NamoID:
# http://localhost:3002/api/auth/callback
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Supabase Project Settings > Data API.
SUPABASE_URL=https://your-project.supabase.co

# Server-only Supabase secret key. Never expose this as NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Override only when testing against a local or self-hosted NamoID API.
# NAMOID_API_BASE_URL=http://localhost:8001
