# NamoID OAuth 2.1 + OIDC config for the ASP.NET Core quickstart.
#
# This app reads these via Environment.GetEnvironmentVariable(...).
# .NET does NOT auto-load a .env file, so export them into your shell
# before `dotnet run`, e.g.:
#
#   export $(grep -v '^#' .env | xargs)   # bash/zsh, after copying to .env
#
# or set them in Properties/launchSettings.json under environmentVariables.

# Issuer URL (the OIDC Authority). Discovery happens at
# <NAMOID_ISSUER>/.well-known/openid-configuration
NAMOID_ISSUER=https://namoid.in/v1/oauth

# OAuth client credentials (confidential client)
NAMOID_CLIENT_ID=your-client-id
NAMOID_CLIENT_SECRET=your-client-secret

# Redirect URI registered in NamoID. The OpenIdConnect handler's default
# callback path is /signin-oidc, so this MUST end in /signin-oidc.
NAMOID_REDIRECT_URI=http://localhost:3009/signin-oidc
