# Standalone Next.js example
NEXTJS_NAMOID_CLIENT_ID=namoid_client_test_xxxxxxxxxxxxxxxx
NEXTJS_NAMOID_CLIENT_SECRET=namoid_secret_test_xxxxxxxxxxxxxxxx
NEXTJS_APP_URL=http://localhost:3001
NEXTJS_HOST_PORT=3001

# Next.js + Supabase example
SUPABASE_NEXTJS_NAMOID_CLIENT_ID=namoid_client_test_xxxxxxxxxxxxxxxx
SUPABASE_NEXTJS_NAMOID_CLIENT_SECRET=namoid_secret_test_xxxxxxxxxxxxxxxx
SUPABASE_NEXTJS_APP_URL=http://localhost:3002
SUPABASE_NEXTJS_HOST_PORT=3002
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# React SPA example (public client: no secret)
SPA_NAMOID_CLIENT_ID=namoid_client_test_xxxxxxxxxxxxxxxx
SPA_HOST_PORT=5173

# Protected MCP server, Express + TypeScript.
# NAMOID_ISSUER and the resource audience come from the Console:
# Project -> Environment -> MCP Authorization -> Integration details.
# The resource must match the registered audience exactly.
MCP_EXPRESS_TS_NAMOID_ISSUER=https://acme-test.id.namoid.in
MCP_EXPRESS_TS_RESOURCE=https://mcp.acme.example/mcp
MCP_EXPRESS_TS_RESOURCE_NAME=Acme Finance MCP
MCP_EXPRESS_TS_HOST_PORT=3004

# Protected MCP server, FastMCP + Python (register a separate MCP resource)
MCP_FASTMCP_NAMOID_ISSUER=https://acme-test.id.namoid.in
MCP_FASTMCP_RESOURCE=https://mcp-py.acme.example/mcp
MCP_FASTMCP_RESOURCE_NAME=Acme Finance MCP
MCP_FASTMCP_HOST_PORT=3005

# Express + React example
EXPRESS_REACT_NAMOID_CLIENT_ID=namoid_client_test_xxxxxxxxxxxxxxxx
EXPRESS_REACT_NAMOID_CLIENT_SECRET=namoid_secret_test_xxxxxxxxxxxxxxxx
EXPRESS_REACT_APP_URL=http://localhost:3003
EXPRESS_REACT_SESSION_SECRET=replace-with-at-least-32-random-characters
EXPRESS_REACT_HOST_PORT=3003
