# Your project's hosted issuer — https://<your-project-slug>.id.namoid.in (no trailing slash)
NAMOID_ISSUER=https://your-project-slug.id.namoid.in

# From NamoID → Projects → your project → Applications → New application
NAMOID_CLIENT_ID=
NAMOID_CLIENT_SECRET=

# Must match the redirect URI you registered on the OAuth client, character-for-character
NAMOID_REDIRECT_URI=http://localhost:3007/callback

# Local dev server port (the built-in server is started with this; default 3007)
PORT=3007
