# NamoID OAuth client config for the Spring Boot quickstart.
# Copy this file to `.env`, fill in the values from your NamoID application,
# then export them into your shell before running the app:
#
#   set -a; source .env; set +a
#
# Spring resolves the ${...} placeholders in application.yml from these env vars.

# OIDC issuer URL (triggers discovery of authorize/token/jwks/userinfo endpoints).
NAMOID_ISSUER=https://your-namoid-issuer.example/v1/oauth

# Your NamoID application's client id.
NAMOID_CLIENT_ID=your-client-id

# Your NamoID application's one-time client secret (confidential client).
NAMOID_CLIENT_SECRET=your-client-secret

# Must exactly match the redirect URI registered in NamoID.
# Spring's default callback path is /login/oauth2/code/{registrationId}.
NAMOID_REDIRECT_URI=http://localhost:3008/login/oauth2/code/namoid
