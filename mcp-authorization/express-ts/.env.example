# The NamoID environment that authorizes this MCP server.
# Console -> Project -> Environment -> MCP Authorization -> Integration details
# -> "Authorization server". Test and Live are different issuers.
NAMOID_ISSUER=https://acme-test.id.namoid.in

# The canonical public URL of this MCP server, exactly as registered in NamoID
# as the resource audience. Tokens carry this string in `aud`, so any
# difference — trailing slash, http vs https, a different host — rejects every
# token. This is also the URL you give an MCP client.
NAMOID_MCP_RESOURCE=https://mcp.acme.example/mcp

# Name shown to users during discovery and consent.
NAMOID_MCP_RESOURCE_NAME=Acme Finance MCP

# Local listen port. Put a tunnel or proxy in front so the public URL above
# resolves to it.
PORT=3004

# Only used by `pnpm verify`, which talks to the local listener directly.
MCP_BASE_URL=http://localhost:3004
