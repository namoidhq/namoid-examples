# Your project's hosted issuer (no trailing slash).
NAMOID_ISSUER=https://<your-project-slug>.id.namoid.in

# OAuth client credentials from NamoID → Projects → Applications → New application.
NAMOID_CLIENT_ID=
NAMOID_CLIENT_SECRET=

# Must match a redirect URI registered on the client, character-for-character.
NAMOID_REDIRECT_URI=http://localhost:3010/callback

# Local server port (default 3010).
PORT=3010
