# NamoID raw-flow (curl) example — copy to `.env` and fill in.
# `.env` is gitignored; never commit real credentials.

# Your project's hosted issuer URL (no trailing slash).
# e.g. https://my-project.id.namoid.in
NAMOID_ISSUER=

# From NamoID → Projects → your project → Applications → your application.
NAMOID_CLIENT_ID=
NAMOID_CLIENT_SECRET=

# Must match a Redirect URI registered on the application above.
# Nothing actually serves this URL in the example — you copy the `code`
# out of the browser address bar after the redirect.
NAMOID_REDIRECT_URI=http://localhost:3011/callback
