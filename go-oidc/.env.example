# Your project's hosted issuer (no trailing slash).
# Copy this from NamoID → Projects → your project → Applications.
NAMOID_ISSUER=https://<your-project-slug>.id.namoid.in

# OAuth client credentials from the "New application" screen.
NAMOID_CLIENT_ID=
NAMOID_CLIENT_SECRET=

# Must match the redirect URI you registered on the OAuth client, exactly.
NAMOID_REDIRECT_URI=http://localhost:3005/callback

# Port this app listens on (default 3005).
PORT=3005
