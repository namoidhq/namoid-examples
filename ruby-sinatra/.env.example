# Your project's hosted issuer (no trailing slash).
NAMOID_ISSUER=https://your-project-slug.id.namoid.in

# From NamoID → Projects → your project → Applications → New application.
NAMOID_CLIENT_ID=
NAMOID_CLIENT_SECRET=

# Must match the redirect URI registered on the OAuth client, char-for-char.
NAMOID_REDIRECT_URI=http://localhost:3006/callback

# Sinatra cookie session signing key. Generate: openssl rand -hex 32
SESSION_SECRET=

# Port this app listens on (default 3006).
PORT=3006
